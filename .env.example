# Sem VITE_API_URL o app roda em modo demonstração: sem contas, com progresso salvo no navegador.
# Para usar o backend (login, painel do educador, Vosk), informe a URL dele:
# VITE_API_URL=http://localhost:8080

# Motor de fala preferido quando há backend: "server" usa o Vosk do servidor.
# Por padrão é usada a Web Speech API do navegador.
# VITE_SPEECH_ENGINE=server

# Subcaminho do deploy (GitHub Pages). O padrão é "/".
# VITE_BASE_PATH=/Central-do-Alfabeto-FrontEnd/
